# Copy to .env (git-ignored) to make plain `docker compose up -d` use the external drive:
# JOBHUNTER_DATA=/mnt/ssd/jobhunter
# COMPOSE_FILE=compose.yaml:compose.external-drive.yaml

# Optional: API key for the AI agent (Settings -> AI agent), so it is not stored in the database:
# JOBHUNTER_AI_API_KEY=sk-ant-...
